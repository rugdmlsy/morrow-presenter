    sp=subs.add_parser("element-add-connector"); sp.add_argument("path",type=Path); sp.add_argument("slide"); sp.add_argument("from_element"); sp.add_argument("to_element"); sp.add_argument("--from-anchor",choices=VALID_CONNECTOR_ANCHORS,default="auto"); sp.add_argument("--to-anchor",choices=VALID_CONNECTOR_ANCHORS,default="auto"); sp.add_argument("--arrow",choices=VALID_CONNECTOR_ARROWS,default="end"); sp.add_argument("--stroke",default="#4b4d50"); sp.add_argument("--stroke-width",type=float,default=2.0); sp.add_argument("--dash",action="store_true"); add_json(sp)
    sp=subs.add_parser("element-update"); sp.add_argument("path",type=Path); sp.add_argument("slide"); sp.add_argument("element"); sp.add_argument("--role",choices=("none",*VALID_TEXT_ROLES)); add_geometry(sp); sp.add_argument("--scale",type=float); sp.add_argument("--rotation",type=float); sp.add_argument("--opacity",type=float); sp.add_argument("--flip-h",dest="flip_h",action="store_const",const=True); sp.add_argument("--no-flip-h",dest="flip_h",action="store_const",const=False); sp.add_argument("--flip-v",dest="flip_v",action="store_const",const=True); sp.add_argument("--no-flip-v",dest="flip_v",action="store_const",const=False); sp.add_argument("--text"); sp.add_argument("--alt"); sp.add_argument("--shape",choices=VALID_SHAPES); add_text_style(sp); sp.add_argument("--fill"); sp.add_argument("--header-fill"); sp.add_argument("--stroke"); sp.add_argument("--stroke-width",type=float); sp.add_argument("--arrow",choices=VALID_CONNECTOR_ARROWS); sp.add_argument("--dash",dest="dash",action="store_const",const=True); sp.add_argument("--solid",dest="dash",action="store_const",const=False); sp.add_argument("--crop-left",type=float); sp.add_argument("--crop-top",type=float); sp.add_argument("--crop-right",type=float); sp.add_argument("--crop-bottom",type=float); sp.add_argument("--reset-crop",action="store_true"); sp.add_argument("--lock",dest="locked",action="store_const",const=True); sp.add_argument("--unlock",dest="locked",action="store_const",const=False); add_json(sp)
    for name in ("element-delete","element-duplicate"):
        sp=subs.add_parser(name); sp.add_argument("path",type=Path); sp.add_argument("slide"); sp.add_argument("element"); add_json(sp)
    sp=subs.add_parser("table-set"); sp.add_argument("path",type=Path); sp.add_argument("slide"); sp.add_argument("element"); sp.add_argument("row",type=int); sp.add_argument("col",type=int); sp.add_argument("value"); add_json(sp)
    sp=subs.add_parser("table-resize"); sp.add_argument("path",type=Path); sp.add_argument("slide"); sp.add_argument("element"); sp.add_argument("--rows",type=int); sp.add_argument("--cols",type=int); add_json(sp)
    for name in ("table-row-add","table-row-delete","table-col-add","table-col-delete"):
        sp=subs.add_parser(name); sp.add_argument("path",type=Path); sp.add_argument("slide"); sp.add_argument("element"); sp.add_argument("--at",type=int); add_json(sp)
    sp=subs.add_parser("element-group"); sp.add_argument("path",type=Path); sp.add_argument("slide"); sp.add_argument("elements",nargs="+"); add_json(sp)
    sp=subs.add_parser("element-ungroup"); sp.add_argument("path",type=Path); sp.add_argument("slide"); sp.add_argument("element"); add_json(sp)
    sp=subs.add_parser("element-order"); sp.add_argument("path",type=Path); sp.add_argument("slide"); sp.add_argument("element"); group=sp.add_mutually_exclusive_group(required=True); group.add_argument("--to-front",action="store_true"); group.add_argument("--to-back",action="store_true"); group.add_argument("--forward",action="store_true"); group.add_argument("--backward",action="store_true"); group.add_argument("--index",type=int); add_json(sp)
    sp=subs.add_parser("element-align"); sp.add_argument("path",type=Path); sp.add_argument("slide"); sp.add_argument("mode",choices=VALID_ALIGN_MODES); sp.add_argument("elements",nargs="+"); add_json(sp)
    for name in ("open","present"):
        sp=subs.add_parser(name); sp.add_argument("path",type=Path); sp.add_argument("--slide"); add_json(sp)
    sp=subs.add_parser("export"); sp.add_argument("path",type=Path); sp.add_argument("output",type=Path); add_json(sp)
    for name in ("export-pdf","export-pptx"):
        sp=subs.add_parser(name); sp.add_argument("path",type=Path); sp.add_argument("output",type=Path); add_json(sp)
    return p


def make_image_element(path: Path, source: Path, x: float, y: float|None, width: float, alt: str, slide_aspect: float = SLIDE_ASPECT) -> dict:
    rel=import_asset(path, source); iw,ih=image_dimensions(source); width=_clamp(width,1.0,400.0); height=image_height_for_width(width,iw,ih,slide_aspect); y=(100-height)/2 if y is None else y
    return normalize_image_element({"type":"image","path":rel,"alt":alt,"x":x,"y":y,"width":width,"height":height,"intrinsicWidth":iw,"intrinsicHeight":ih,"crop":{"left":0,"top":0,"right":0,"bottom":0}})


def apply_element_update(element: dict, args: argparse.Namespace, slide_aspect: float = SLIDE_ASPECT) -> bool:
    changed=False
    kind=element["type"]
    role_arg=getattr(args,"role",None)
    if role_arg is not None:
        if kind != "text": raise ValueError("--role requires a text element")
        element["role"] = None if role_arg == "none" else role_arg; changed=True
    if args.scale is not None:
        if args.scale <= 0: raise ValueError("--scale must be positive")
        element["width"]=_clamp(element["width"]*args.scale,.5,400.0)
        if kind=="image": element["height"]=image_height_for_width(element["width"],element["intrinsicWidth"],element["intrinsicHeight"],slide_aspect)
        else: element["height"]=_clamp(element["height"]*args.scale,.5,400.0)
        changed=True
    if args.width is not None:
        element["width"]=_clamp(args.width,.5,400.0)
        if kind=="image": element["height"]=image_height_for_width(element["width"],element["intrinsicWidth"],element["intrinsicHeight"],slide_aspect)
        changed=True
    if args.height is not None:
        if kind=="image":
            # Images stay proportional: height requests derive width.
            target=_clamp(args.height,.5,400.0); ratio=element["width"]/element["height"] if element["height"] else 1; element["height"]=target; element["width"]=_clamp(target*ratio,.5,400.0)
        else: element["height"]=_clamp(args.height,.5,400.0)
        changed=True
    mapping=(("x",args.x),("y",args.y),("rotation",args.rotation),("opacity",args.opacity),("flipH",getattr(args,"flip_h",None)),("flipV",getattr(args,"flip_v",None)),("text",args.text),("alt",args.alt),("shape",args.shape),("fontFamily",args.font_family),("fontSize",args.font_size),("fontWeight",args.font_weight),("italic",args.italic),("underline",args.underline),("color",args.color),("align",args.align),("verticalAlign",args.vertical_align),("listStyle",getattr(args,"list_style",None)),("lineSpacing",getattr(args,"line_spacing",None)),("paragraphSpacing",getattr(args,"paragraph_spacing",None)),("indent",getattr(args,"indent",None)),("autoFit",getattr(args,"auto_fit",None)),("fill",args.fill),("headerFill",getattr(args,"header_fill",None)),("stroke",args.stroke),("strokeWidth",args.stroke_width),("arrow",getattr(args,"arrow",None)),("dash",getattr(args,"dash",None)),("locked",args.locked))
    for key,value in mapping:
        if value is None: continue
        allowed = (key in {"x","y","rotation","opacity","locked"} and kind!="connector") or (key in {"flipH","flipV"} and kind in {"image","shape"}) or (key in {"opacity","locked"} and kind=="connector") or (kind=="image" and key=="alt") or (kind=="text" and key in {"text","fontFamily","fontSize","fontWeight","italic","underline","color","align","verticalAlign","listStyle","lineSpacing","paragraphSpacing","indent","autoFit","fill","stroke","strokeWidth"}) or (kind=="shape" and key in {"text","shape","fontFamily","fontSize","fontWeight","italic","underline","color","align","verticalAlign","listStyle","lineSpacing","paragraphSpacing","indent","autoFit","fill","stroke","strokeWidth"}) or (kind=="table" and key in {"fontFamily","fontSize","fontWeight","italic","underline","color","align","verticalAlign","fill","headerFill","stroke","strokeWidth"}) or (kind=="connector" and key in {"stroke","strokeWidth","arrow","dash"})
        if allowed: element[key]=value; changed=True
    crop_values={"left":args.crop_left,"top":args.crop_top,"right":args.crop_right,"bottom":args.crop_bottom}
    if args.reset_crop:
        if kind!="image": raise ValueError("crop options require an image element")
        element["crop"]={"left":0,"top":0,"right":0,"bottom":0}; changed=True
    if any(v is not None for v in crop_values.values()):
        if kind!="image": raise ValueError("crop options require an image element")
        crop=dict(element["crop"])
        for key,value in crop_values.items():
            if value is not None: crop[key]=value
        element["crop"]=normalize_crop(crop); changed=True
    return changed


def align_elements(slide_obj: dict, refs: list[str], mode: str) -> list[dict]:
    resolved=[]; seen=set()
    for ref in refs:
        _,e=resolve_element(slide_obj,ref)
        if e["id"] not in seen: resolved.append(e); seen.add(e["id"])
    if not resolved: raise ValueError("no elements selected")
    if mode.startswith("distribute") and len(resolved)<3: raise ValueError("distribution requires at least 3 elements")
    min_x=min(e["x"] for e in resolved); max_r=max(e["x"]+e["width"] for e in resolved); min_y=min(e["y"] for e in resolved); max_b=max(e["y"]+e["height"] for e in resolved)
    if mode=="left":
        for e in resolved: e["x"]=min_x
    elif mode=="center":
        target=(min_x+max_r)/2
        for e in resolved: e["x"]=target-e["width"]/2
    elif mode=="right":
        for e in resolved: e["x"]=max_r-e["width"]
    elif mode=="top":
        for e in resolved: e["y"]=min_y
    elif mode=="middle":
        target=(min_y+max_b)/2
        for e in resolved: e["y"]=target-e["height"]/2
    elif mode=="bottom":
        for e in resolved: e["y"]=max_b-e["height"]
    elif mode=="distribute-h":
        ordered=sorted(resolved,key=lambda e:e["x"]); total=sum(e["width"] for e in ordered); gap=(max_r-min_x-total)/(len(ordered)-1); cursor=min_x
        for e in ordered: e["x"]=cursor; cursor+=e["width"]+gap
    elif mode=="distribute-v":
        ordered=sorted(resolved,key=lambda e:e["y"]); total=sum(e["height"] for e in ordered); gap=(max_b-min_y-total)/(len(ordered)-1); cursor=min_y
        for e in ordered: e["y"]=cursor; cursor+=e["height"]+gap
    return resolved


def table_element_for(slide_obj: dict, ref: str) -> tuple[int, dict]:
    index, element = resolve_element(slide_obj, ref)
    if element.get("type") != "table": raise ValueError("operation requires a table element")
    return index, element


def resize_table(element: dict, rows: int | None = None, cols: int | None = None) -> dict:
    rows = element["rows"] if rows is None else max(1, min(50, int(rows)))
    cols = element["cols"] if cols is None else max(1, min(30, int(cols)))
    cells=[]
    for r in range(rows):
        old=element["cells"][r] if r < element["rows"] else []
        cells.append([old[c] if c < len(old) else "" for c in range(cols)])
    element["rows"]=rows; element["cols"]=cols; element["cells"]=cells
    return normalize_table_element(element)


def uv_executable() -> str:
    candidates = [shutil.which("uv"), str(Path.home()/".local/bin/uv"), "/opt/homebrew/bin/uv", "/usr/local/bin/uv"]
    for candidate in candidates:
        if candidate and Path(candidate).is_file(): return candidate
    raise ValueError("uv is required for PDF/PPTX export; install uv first")


def exporter_script(kind: str) -> Path:
    name = "export-pdf.py" if kind == "pdf" else "export-pptx.py"
    candidate = Path(__file__).resolve().parents[1]/"scripts"/name
    if candidate.is_file(): return candidate
    raise ValueError(f"export helper not found: {candidate}")


def importer_script() -> Path:
    candidate = Path(__file__).resolve().parents[1]/"scripts"/"import-pptx.py"
    if candidate.is_file(): return candidate
    raise ValueError(f"import helper not found: {candidate}")


def run_pptx_import(source: Path, output: Path, force: bool = False) -> Path:
    source=source.expanduser().resolve();output=output.expanduser().resolve()
    if source.suffix.lower() != ".pptx" or not source.is_file(): raise ValueError(f"PowerPoint file not found: {source}")
    if output.suffix.lower() != ".morrowdeck": output=output.with_suffix(".morrowdeck")
    if output.exists() and not force: raise ValueError(f"refusing to overwrite existing deck: {output}; use --force")
    proc=subprocess.run([uv_executable(),"run","--script",str(importer_script()),str(source),str(output)],text=True,capture_output=True)
    if proc.returncode != 0:
        detail=(proc.stderr or proc.stdout).strip();raise ValueError(f"PPTX import failed: {detail[-1200:]}")
    deck=read_deck(output);write_deck(output,deck)
    missing=missing_assets(deck,output)
    if missing: raise ValueError("PPTX import created missing assets: "+", ".join(missing))
    return output


def run_rich_export(kind: str, deck_path: Path, output: Path) -> Path:
    expected = ".pdf" if kind == "pdf" else ".pptx"
    output = output.expanduser().resolve()
    if output.suffix.lower() != expected: output = output.with_suffix(expected)
    deck = read_deck(deck_path)
    missing = missing_assets(deck, deck_path)
    if missing: raise ValueError("missing image assets: "+", ".join(missing))
    deck_path=deck_path.expanduser().resolve(); fd,temp_name=tempfile.mkstemp(prefix=f".{deck_path.stem}.normalized-",suffix=".morrowdeck",dir=deck_path.parent)
    os.close(fd); temp_path=Path(temp_name)
    try:
        temp_path.write_text(json.dumps(deck,ensure_ascii=False,indent=2)+"\n",encoding="utf-8")
        proc = subprocess.run([uv_executable(), "run", "--script", str(exporter_script(kind)), str(temp_path), str(output)], text=True, capture_output=True)
    finally:
        temp_path.unlink(missing_ok=True)
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout).strip(); raise ValueError(f"{kind.upper()} export failed: {detail[-1200:]}")
    if not output.is_file() or output.stat().st_size == 0: raise ValueError(f"{kind.upper()} export produced no file")
    return output


def main() -> int:
    args=parser().parse_args()
    try:
        cmd=args.command
        if cmd=="capabilities": emit(capabilities(),args.json); return 0
        if cmd=="schema": emit(schema(),True); return 0
        if cmd=="new":
            path=args.path.expanduser().resolve()
            if path.exists() and not args.force: raise ValueError(f"refusing to overwrite existing deck: {path}; use --force")
            write_deck(path,new_deck(args.title)); emit({"ok":True,"path":str(path),"message":f"Created {path}"},args.json); return 0
        if cmd=="import-pptx":
            output=run_pptx_import(args.input,args.output,args.force);deck=read_deck(output);emit({"ok":True,"path":str(output),"slides":len(deck["slides"]),"elements":sum(len(x["elements"]) for x in deck["slides"]),"message":f"Imported {args.input} to {output}"},args.json);return 0
        deck=read_deck(args.path.expanduser()); path=args.path.expanduser().resolve()
        if cmd=="validate":
            missing=missing_assets(deck,path)
            if missing: raise ValueError("missing image assets: "+", ".join(missing))
            elements=sum(len(s["elements"]) for s in deck["slides"]); images=sum(1 for _ in image_elements(deck)); emit({"ok":True,"path":str(path),"slides":len(deck["slides"]),"elements":elements,"images":images,"format_version":VERSION,"message":f"Valid deck: {len(deck['slides'])} slides, {elements} elements"},args.json)
        elif cmd=="info":
            emit({"path":str(path),"title":deck["title"],"slides":len(deck["slides"]),"elements":sum(len(s["elements"]) for s in deck["slides"]),"images":sum(1 for _ in image_elements(deck)),"selectedId":deck["selectedId"],"format_version":VERSION},args.json)
        elif cmd=="slides":
            items=[{"position":i+1,**item} for i,item in enumerate(deck["slides"])]
            if args.json: emit(items,True)
            else:
                for item in items:
                    rt=role_element(item,"title"); label=rt.get("text","") if rt else ""; print(f"{item['position']:>3}  {item['id']}  {item['layout']:<10}  {len(item['elements']):>2} objects  {label or '(untitled)'}")
        elif cmd=="get":
            index,item=resolve_slide(deck,args.slide); emit({"position":index+1,**item},args.json)
        elif cmd=="title":
            deck["title"]=args.title; write_deck(path,deck); emit({"ok":True,"title":args.title,"message":f"Deck title set to: {args.title}"},args.json)
        elif cmd=="add":
            item=slide(args.title,body_value(args) or "",args.layout,deck["theme"]); insert_at=resolve_slide(deck,args.after)[0]+1 if args.after else len(deck["slides"]); deck["slides"].insert(insert_at,item); deck["selectedId"]=item["id"]; write_deck(path,deck); emit({"ok":True,"position":insert_at+1,**item,"message":f"Added slide {insert_at+1}"},args.json)
        elif cmd=="set":
            index,item=resolve_slide(deck,args.slide); body=body_value(args); changed=False
            if args.layout is not None: apply_layout_template(item,args.layout,deck["theme"]); changed=True
            if args.title is not None: ensure_role(item,"title",deck["theme"],args.title); changed=True
            if body is not None: ensure_role(item,"body",deck["theme"],body); changed=True
            if not changed: raise ValueError("set requires --layout, --title, --body, or --body-file")
            deck["selectedId"]=item["id"]; write_deck(path,deck); emit({"ok":True,"position":index+1,**item,"message":f"Updated slide {index+1}"},args.json)
        elif cmd=="duplicate":
            index,source=resolve_slide(deck,args.slide); item=copy.deepcopy(source); item["id"]=str(uuid.uuid4()); item["elements"]=remap_elements(source["elements"])
            deck["slides"].insert(index+1,item); deck["selectedId"]=item["id"]; write_deck(path,deck); emit({"ok":True,"position":index+2,**item,"message":f"Duplicated slide {index+1} to {index+2}"},args.json)
        elif cmd=="delete":
            index,item=resolve_slide(deck,args.slide)
            if len(deck["slides"])==1: deck["slides"][0]=slide(theme=deck["theme"]); deck["slides"][0]["id"]=item["id"]; deck["selectedId"]=item["id"]; message="Cleared the only slide"
            else: deck["slides"].pop(index); selected=deck["slides"][min(index,len(deck["slides"])-1)]; deck["selectedId"]=selected["id"]; message=f"Deleted slide {index+1}"
            write_deck(path,deck); emit({"ok":True,"message":message},args.json)
        elif cmd=="move":
            index,item=resolve_slide(deck,args.slide)
            if not 1<=args.to<=len(deck["slides"]): raise ValueError(f"--to must be between 1 and {len(deck['slides'])}")
            deck["slides"].pop(index); deck["slides"].insert(args.to-1,item); deck["selectedId"]=item["id"]; write_deck(path,deck); emit({"ok":True,"id":item["id"],"position":args.to,"message":f"Moved slide to {args.to}"},args.json)
        elif cmd=="slide-style":
            index,item=resolve_slide(deck,args.slide); notes=notes_value(args); changed=False
            if args.background is not None: item["background"]=args.background; changed=True
            if notes is not None: item["notes"]=notes; changed=True
            if args.transition is not None: item["transition"]["type"]=args.transition; changed=True
            if args.transition_duration is not None: item["transition"]["duration"]=_clamp(args.transition_duration,.05,5); changed=True
            if not changed: raise ValueError("slide-style requires background, notes, or transition options")
            write_deck(path,deck); emit({"ok":True,"position":index+1,"background":item["background"],"notes":item["notes"],"transition":item["transition"],"message":f"Updated slide {index+1} style"},args.json)
        elif cmd=="page-size":
            page=dict(PAGE_PRESETS[args.preset]); aspect=page["width"]/page["height"]; deck["page"]=page
            for slide_obj in deck["slides"]:
                for e in slide_obj["elements"]:
                    if e.get("type")=="image": e["height"]=image_height_for_width(e["width"],e["intrinsicWidth"],e["intrinsicHeight"],aspect)
            write_deck(path,deck); emit({"ok":True,"page":page,"message":f"Slide size set to {args.preset}"},args.json)
        elif cmd=="footer-set":
            footer=deck["footer"]; changed=False
            for key,value in (("text",args.text),("showText",args.show_text),("showSlideNumber",args.show_slide_number),("fontFamily",args.font_family),("fontSize",args.font_size),("color",args.color)):
                if value is not None: footer[key]=value; changed=True
            deck["footer"]=normalize_footer(footer)
            if changed: write_deck(path,deck); emit({"ok":True,"footer":deck["footer"],"message":"Updated footer"},args.json)
            else: emit(deck["footer"],args.json)
        elif cmd=="theme":
            emit(deck["theme"],args.json)
        elif cmd=="theme-set":
            deck["theme"]=dict(THEME_PRESETS[args.preset])
            if args.apply_all:
                theme=deck["theme"]
                for slide_obj in deck["slides"]:
                    slide_obj["background"]=theme["background"]
                    for e in slide_obj["elements"]:
                        if e["type"] in {"text","shape","table"}:
                            e["fontFamily"]=theme["titleFontFamily"] if e["type"]=="text" and e.get("role")=="title" else theme["fontFamily"]; e["color"]=theme["text"]
            write_deck(path,deck); emit({"ok":True,"theme":deck["theme"],"appliedAll":args.apply_all,"message":f"Theme set to {args.preset}"},args.json)
        elif cmd=="view-settings":
            view=deck["view"]; changed=False
            for key,value in (("snapToObjects",args.snap_to_objects),("snapToGrid",args.snap_to_grid),("showGrid",args.show_grid),("showGuides",args.show_guides),("showElementLabels",args.show_element_labels)):
                if value is not None: view[key]=value; changed=True
            if args.grid_size is not None: view["gridSize"]=_clamp(args.grid_size,.25,25); changed=True
            if args.clear_guides: view["guideX"]=[]; view["guideY"]=[]; changed=True
            if args.guide_x is not None: view["guideX"]=[_clamp(x,-300,300) for x in args.guide_x]; changed=True
            if args.guide_y is not None: view["guideY"]=[_clamp(y,-300,300) for y in args.guide_y]; changed=True
            if not changed: emit(view,args.json)
            else: write_deck(path,deck); emit({"ok":True,"view":deck["view"],"message":"Updated view settings"},args.json)
        elif cmd=="elements":
            _,item=resolve_slide(deck,args.slide); emit([{"position":i+1,**e} for i,e in enumerate(item["elements"])],args.json)
        elif cmd=="element-get":
            _,item=resolve_slide(deck,args.slide); index,e=resolve_element(item,args.element); emit({"position":index+1,**e},args.json)
        elif cmd=="element-add-text":
            sidx,item=resolve_slide(deck,args.slide); e=normalize_text_element({"type":"text","role":None if args.role=="none" else args.role,"text":args.text,"x":args.x,"y":args.y,"width":args.width,"height":args.height,"fontFamily":args.font_family,"fontSize":args.font_size,"fontWeight":args.font_weight,"italic":args.italic,"underline":args.underline,"color":args.color,"align":args.align,"verticalAlign":args.vertical_align,"listStyle":args.list_style,"lineSpacing":args.line_spacing,"paragraphSpacing":args.paragraph_spacing,"indent":args.indent,"autoFit":args.auto_fit,"fill":args.fill,"stroke":args.stroke,"strokeWidth":args.stroke_width});
            if e.get("role"):
                for other in item["elements"]:
                    if other.get("type")=="text" and other.get("role")==e["role"]: other["role"]=None
            item["elements"].append(e); write_deck(path,deck); emit({"ok":True,"slide":sidx+1,"position":len(item["elements"]),"element":e,"message":"Added text box"},args.json)
        elif cmd=="element-add-shape":
            sidx,item=resolve_slide(deck,args.slide); e=normalize_shape_element({"type":"shape","shape":args.shape,"text":args.text,"x":args.x,"y":args.y,"width":args.width,"height":args.height,"fontFamily":args.font_family,"fontSize":args.font_size,"fontWeight":args.font_weight,"italic":args.italic,"underline":args.underline,"color":args.color,"align":args.align,"verticalAlign":args.vertical_align,"listStyle":args.list_style,"lineSpacing":args.line_spacing,"paragraphSpacing":args.paragraph_spacing,"indent":args.indent,"autoFit":args.auto_fit,"fill":args.fill,"stroke":args.stroke,"strokeWidth":args.stroke_width}); item["elements"].append(e); write_deck(path,deck); emit({"ok":True,"slide":sidx+1,"position":len(item["elements"]),"element":e,"message":f"Added {args.shape} shape"},args.json)
        elif cmd=="element-add-image":
            sidx,item=resolve_slide(deck,args.slide); e=make_image_element(path,args.image,args.x,args.y,args.width,args.alt,page_aspect(deck)); item["elements"].append(e); write_deck(path,deck); emit({"ok":True,"slide":sidx+1,"position":len(item["elements"]),"element":e,"message":"Added image"},args.json)
        elif cmd=="element-add-table":
            sidx,item=resolve_slide(deck,args.slide); cells=[]
            if args.cells_json:
                try: cells=json.loads(args.cells_json)
                except json.JSONDecodeError as exc: raise ValueError(f"invalid --cells-json: {exc}") from None
            e=normalize_table_element({"type":"table","rows":args.rows,"cols":args.cols,"cells":cells,"x":args.x,"y":args.y,"width":args.width,"height":args.height,"fontFamily":args.font_family,"fontSize":args.font_size,"color":args.color,"fill":args.fill,"headerFill":args.header_fill,"stroke":args.stroke,"strokeWidth":args.stroke_width}); item["elements"].append(e); write_deck(path,deck); emit({"ok":True,"slide":sidx+1,"position":len(item["elements"]),"element":e,"message":"Added table"},args.json)
        elif cmd=="element-add-connector":
            sidx,item=resolve_slide(deck,args.slide); _,a=resolve_element(item,args.from_element); _,b=resolve_element(item,args.to_element)
            if a["id"]==b["id"]: raise ValueError("connector endpoints must reference different elements")
            e=normalize_connector_element({"type":"connector","from":{"elementId":a["id"],"anchor":args.from_anchor},"to":{"elementId":b["id"],"anchor":args.to_anchor},"arrow":args.arrow,"stroke":args.stroke,"strokeWidth":args.stroke_width,"dash":args.dash}); item["elements"].append(e); write_deck(path,deck); emit({"ok":True,"slide":sidx+1,"position":len(item["elements"]),"element":e,"message":"Added connector"},args.json)
        elif cmd=="element-update":
            sidx,item=resolve_slide(deck,args.slide); eidx,e=resolve_element(item,args.element)
            if not apply_element_update(e,args,page_aspect(deck)): raise ValueError("element-update requires at least one update option")
            if e.get("type")=="text" and e.get("role"):
                for other in item["elements"]:
                    if other is not e and other.get("type")=="text" and other.get("role")==e["role"]: other["role"]=None
            item["elements"][eidx]=normalize_element(e); write_deck(path,deck); emit({"ok":True,"slide":sidx+1,"position":eidx+1,"element":item["elements"][eidx],"message":"Updated element"},args.json)
        elif cmd=="element-delete":
            sidx,item=resolve_slide(deck,args.slide); eidx,e=resolve_element(item,args.element); item["elements"].pop(eidx); write_deck(path,deck); emit({"ok":True,"slide":sidx+1,"removed":e,"message":"Deleted element"},args.json)
        elif cmd=="element-duplicate":
            sidx,item=resolve_slide(deck,args.slide); eidx,e=resolve_element(item,args.element); dup=copy.deepcopy(e); dup["id"]=str(uuid.uuid4()); dup["groupId"]=None
            if dup["type"]=="text": dup["role"]=None
            if dup["type"]!="connector": dup["x"]+=2; dup["y"]+=2
            item["elements"].insert(eidx+1,dup); write_deck(path,deck); emit({"ok":True,"slide":sidx+1,"position":eidx+2,"element":dup,"message":"Duplicated element"},args.json)
        elif cmd=="table-set":
            sidx,item=resolve_slide(deck,args.slide); eidx,e=resolve_element(item,args.element)
            if e["type"]!="table": raise ValueError("table-set requires a table element")
            if not 1<=args.row<=e["rows"] or not 1<=args.col<=e["cols"]: raise ValueError("table cell out of range")
            e["cells"][args.row-1][args.col-1]=args.value; item["elements"][eidx]=normalize_table_element(e); write_deck(path,deck); emit({"ok":True,"slide":sidx+1,"row":args.row,"col":args.col,"value":args.value,"message":"Updated table cell"},args.json)
        elif cmd=="table-resize":
            sidx,item=resolve_slide(deck,args.slide); eidx,e=table_element_for(item,args.element)
            if args.rows is None and args.cols is None: raise ValueError("table-resize requires --rows or --cols")
            item["elements"][eidx]=resize_table(e,args.rows,args.cols); write_deck(path,deck); emit({"ok":True,"slide":sidx+1,"element":item["elements"][eidx],"message":"Resized table"},args.json)
        elif cmd in {"table-row-add","table-row-delete","table-col-add","table-col-delete"}:
            sidx,item=resolve_slide(deck,args.slide); eidx,e=table_element_for(item,args.element)
            if cmd=="table-row-add":
                at=e["rows"]+1 if args.at is None else args.at
                if not 1<=at<=e["rows"]+1: raise ValueError("--at row out of range")
                e["cells"].insert(at-1,["" for _ in range(e["cols"])]); e["rows"]+=1
            elif cmd=="table-row-delete":
                if e["rows"]<=1: raise ValueError("table must keep at least one row")
                at=e["rows"] if args.at is None else args.at
                if not 1<=at<=e["rows"]: raise ValueError("--at row out of range")
                e["cells"].pop(at-1); e["rows"]-=1
            elif cmd=="table-col-add":
                at=e["cols"]+1 if args.at is None else args.at
                if not 1<=at<=e["cols"]+1: raise ValueError("--at column out of range")
                for row in e["cells"]: row.insert(at-1,"")
                e["cols"]+=1
            else:
                if e["cols"]<=1: raise ValueError("table must keep at least one column")
                at=e["cols"] if args.at is None else args.at
                if not 1<=at<=e["cols"]: raise ValueError("--at column out of range")
                for row in e["cells"]: row.pop(at-1)
                e["cols"]-=1
            item["elements"][eidx]=normalize_table_element(e); write_deck(path,deck); emit({"ok":True,"slide":sidx+1,"element":item["elements"][eidx],"message":"Updated table structure"},args.json)
        elif cmd=="element-group":
            sidx,item=resolve_slide(deck,args.slide); members=resolve_elements(item,args.elements)
            if len(members)<2: raise ValueError("element-group requires at least two distinct elements")
            gid=str(uuid.uuid4())
            for e in members: e["groupId"]=gid
            write_deck(path,deck); emit({"ok":True,"slide":sidx+1,"groupId":gid,"elements":[e["id"] for e in members],"message":f"Grouped {len(members)} elements"},args.json)
        elif cmd=="element-ungroup":
            sidx,item=resolve_slide(deck,args.slide); _,target=resolve_element(item,args.element); gid=target.get("groupId")
            if not gid: raise ValueError("element is not grouped")
            members=[]
            for e in item["elements"]:
                if e.get("groupId")==gid: e["groupId"]=None; members.append(e["id"])
            write_deck(path,deck); emit({"ok":True,"slide":sidx+1,"groupId":gid,"elements":members,"message":f"Ungrouped {len(members)} elements"},args.json)
        elif cmd=="element-order":
            sidx,item=resolve_slide(deck,args.slide); eidx,e=resolve_element(item,args.element); elements=item["elements"]; elements.pop(eidx)
            if args.to_front: target=len(elements)
            elif args.to_back: target=0
            elif args.forward: target=min(len(elements),eidx+1)
            elif args.backward: target=max(0,eidx-1)
            else:
                if not 1<=args.index<=len(elements)+1: raise ValueError(f"--index must be between 1 and {len(elements)+1}")
                target=args.index-1
            elements.insert(target,e); write_deck(path,deck); emit({"ok":True,"slide":sidx+1,"position":target+1,"element":e,"message":"Reordered element"},args.json)
        elif cmd=="element-align":
            sidx,item=resolve_slide(deck,args.slide); updated=align_elements(item,args.elements,args.mode); write_deck(path,deck); emit({"ok":True,"slide":sidx+1,"mode":args.mode,"elements":updated,"message":f"Aligned {len(updated)} elements"},args.json)
        elif cmd=="open":
            if args.slide: resolve_slide(deck,args.slide)
            launch(path,False,args.slide); emit({"ok":True,"path":str(path),"message":f"Opened {path}"},args.json)
        elif cmd=="present":
            if args.slide: resolve_slide(deck,args.slide)
            launch(path,True,args.slide); emit({"ok":True,"path":str(path),"message":f"Presenting {path}"},args.json)
        elif cmd=="export":
            output=args.output.expanduser().resolve(); copy_assets(deck,path,output); write_deck(output,deck); emit({"ok":True,"path":str(output),"message":f"Exported {output}"},args.json)
        elif cmd in {"export-pdf","export-pptx"}:
            kind="pdf" if cmd=="export-pdf" else "pptx"; output=run_rich_export(kind,path,args.output); emit({"ok":True,"path":str(output),"format":kind,"message":f"Exported {output}"},args.json)
        else: raise ValueError(f"unsupported command: {cmd}")
        return 0
    except (ValueError,OSError,subprocess.CalledProcessError) as exc:
        print(f"morrow-presenter: {exc}",file=sys.stderr); return 2

if __name__=="__main__": raise SystemExit(main())
