#!/usr/bin/env python3
"""Morrow Presenter shell interface.

All persistent Presenter operations are available here so agents can operate decks
without GUI automation or MCP.
"""
from __future__ import annotations

import argparse
import copy
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import uuid

VERSION = 1
VALID_LAYOUTS = ("title-body", "title", "section", "blank")
VALID_ELEMENT_TYPES = ("text", "shape", "image", "table", "connector")
VALID_SHAPES = ("rect", "rounded-rect", "ellipse", "line", "arrow", "triangle", "diamond", "pentagon", "hexagon", "star", "chevron")
VALID_ALIGN = ("left", "center", "right")
VALID_VALIGN = ("top", "middle", "bottom")
VALID_TEXT_ROLES = ("title", "body")
VALID_LIST_STYLES = ("none", "bullet", "number")
VALID_TRANSITIONS = ("none", "fade")
VALID_ALIGN_MODES = ("left", "center", "right", "top", "middle", "bottom", "distribute-h", "distribute-v")
VALID_CONNECTOR_ARROWS = ("none", "end", "both")
VALID_CONNECTOR_ANCHORS = ("auto", "top", "right", "bottom", "left", "center")
VALID_THEME_PRESETS = ("default", "dark", "warm", "blue")
PAGE_PRESETS = {
    "wide": {"preset":"wide","width":13.333333,"height":7.5},
    "standard": {"preset":"standard","width":10.0,"height":7.5},
}
SLIDE_ASPECT = 16 / 9
DEFAULT_IMAGE_WIDTH = 40.0
SUPPORTED_IMAGE_EXTS = {".png", ".jpg", ".jpeg", ".gif", ".webp", ".heic", ".heif"}
ASSET_DIR = ".morrow-assets"
APP_CANDIDATES = (
    Path("/Applications/Morrow Presenter.app"),
    Path.home() / "Applications" / "Morrow Presenter.app",
    Path(__file__).resolve().parents[1] / "dist" / "Morrow Presenter.app",
)


def _number(value: object, default: float) -> float:
    return float(value) if isinstance(value, (int, float)) and not isinstance(value, bool) else default


def _clamp(value: float, low: float, high: float) -> float:
    return max(low, min(high, value))


def _bool(value: object, default: bool = False) -> bool:
    return value if isinstance(value, bool) else default


def _string(value: object, default: str = "") -> str:
    return value if isinstance(value, str) else default


def _safe_asset_path(path: object) -> str:
    if not isinstance(path, str) or not path.strip():
        raise ValueError("image path must be a non-empty relative path")
    path = path.replace("\\", "/")
    candidate = Path(path)
    if candidate.is_absolute() or ".." in candidate.parts:
        raise ValueError("image path must stay inside the deck directory")
    return path


def image_height_for_width(width: float, intrinsic_width: float, intrinsic_height: float, slide_aspect: float = SLIDE_ASPECT) -> float:
    aspect = intrinsic_width / intrinsic_height if intrinsic_width > 0 and intrinsic_height > 0 else slide_aspect
    return width * slide_aspect / aspect



def normalize_page(raw: object) -> dict:
    raw = raw if isinstance(raw, dict) else {}
    preset = raw.get("preset")
    if preset in PAGE_PRESETS:
        return dict(PAGE_PRESETS[preset])
    width = _clamp(_number(raw.get("width"), 13.333333), 1.0, 100.0)
    height = _clamp(_number(raw.get("height"), 7.5), 1.0, 100.0)
    return {"preset":"custom","width":width,"height":height}


def normalize_footer(raw: object) -> dict:
    raw = raw if isinstance(raw, dict) else {}
    return {
        "text": _string(raw.get("text")),
        "showText": _bool(raw.get("showText"), False),
        "showSlideNumber": _bool(raw.get("showSlideNumber"), False),
        "fontFamily": _string(raw.get("fontFamily"), "Inter"),
        "fontSize": _clamp(_number(raw.get("fontSize"), 11.0), 6.0, 40.0),
        "color": _string(raw.get("color"), "#666666"),
    }


def page_aspect(deck: dict) -> float:
    page = deck.get("page", PAGE_PRESETS["wide"])
    return float(page["width"]) / float(page["height"])

def normalize_crop(raw: object) -> dict:
    raw = raw if isinstance(raw, dict) else {}
    left = _clamp(_number(raw.get("left"), 0.0), 0.0, 95.0)
    top = _clamp(_number(raw.get("top"), 0.0), 0.0, 95.0)
    right = _clamp(_number(raw.get("right"), 0.0), 0.0, 95.0)
    bottom = _clamp(_number(raw.get("bottom"), 0.0), 0.0, 95.0)
    if left + right > 95.0:
        right = max(0.0, 95.0 - left)
    if top + bottom > 95.0:
        bottom = max(0.0, 95.0 - top)
    return {"left": left, "top": top, "right": right, "bottom": bottom}


def normalize_transition(raw: object) -> dict:
    if isinstance(raw, str):
        raw = {"type": raw}
    raw = raw if isinstance(raw, dict) else {}
    kind = raw.get("type") if raw.get("type") in VALID_TRANSITIONS else "none"
    duration = _clamp(_number(raw.get("duration"), 0.35), 0.05, 5.0)
    return {"type": kind, "duration": duration}


def element_common(raw: dict, *, default_width: float, default_height: float) -> dict:
    return {
        "id": raw.get("id") if isinstance(raw.get("id"), str) and raw.get("id") else str(uuid.uuid4()),
        "x": _clamp(_number(raw.get("x"), 10.0), -300.0, 300.0),
        "y": _clamp(_number(raw.get("y"), 10.0), -300.0, 300.0),
        "width": _clamp(_number(raw.get("width"), default_width), 0.5, 400.0),
        "height": _clamp(_number(raw.get("height"), default_height), 0.5, 400.0),
        "rotation": _number(raw.get("rotation"), 0.0) % 360.0,
        "opacity": _clamp(_number(raw.get("opacity"), 1.0), 0.0, 1.0),
        "locked": _bool(raw.get("locked"), False),
        "groupId": raw.get("groupId") if isinstance(raw.get("groupId"), str) and raw.get("groupId") else None,
        "flipH": _bool(raw.get("flipH"), False), "flipV": _bool(raw.get("flipV"), False),
    }


def normalize_image_element(raw: object) -> dict:
    if not isinstance(raw, dict):
        raise ValueError("image element must be an object")
    path = _safe_asset_path(raw.get("path"))
    iw = max(1.0, _number(raw.get("intrinsicWidth"), 16.0))
    ih = max(1.0, _number(raw.get("intrinsicHeight"), 9.0))
    width = _clamp(_number(raw.get("width"), DEFAULT_IMAGE_WIDTH), 1.0, 400.0)
    height = _clamp(_number(raw.get("height"), image_height_for_width(width, iw, ih)), 1.0, 400.0)
    common = element_common(raw, default_width=width, default_height=height)
    common["width"] = width
    common["height"] = height
    return {
        "id": common["id"], "type": "image",
        "path": path,
        "alt": _string(raw.get("alt")),
        "x": common["x"], "y": common["y"], "width": width, "height": height,
        "intrinsicWidth": iw, "intrinsicHeight": ih,
        "crop": normalize_crop(raw.get("crop")),
        "rotation": common["rotation"], "opacity": common["opacity"], "locked": common["locked"], "groupId": common["groupId"],
        "flipH": common["flipH"], "flipV": common["flipV"],
    }


def normalize_text_style(raw: dict) -> dict:
    align = raw.get("align") if raw.get("align") in VALID_ALIGN else "left"
    valign = raw.get("verticalAlign") if raw.get("verticalAlign") in VALID_VALIGN else "top"
    return {
        "fontFamily": _string(raw.get("fontFamily"), "Inter"),
        "fontSize": _clamp(_number(raw.get("fontSize"), 28.0), 4.0, 300.0),
        "fontWeight": int(_clamp(_number(raw.get("fontWeight"), 400.0), 100.0, 900.0)),
        "italic": _bool(raw.get("italic")),
        "underline": _bool(raw.get("underline")),
        "color": _string(raw.get("color"), "#202124"),
        "align": align,
        "verticalAlign": valign,
        "listStyle": raw.get("listStyle") if raw.get("listStyle") in VALID_LIST_STYLES else "none",
        "lineSpacing": _clamp(_number(raw.get("lineSpacing"), 1.2), 0.7, 4.0),
        "paragraphSpacing": _clamp(_number(raw.get("paragraphSpacing"), 0.0), 0.0, 72.0),
        "indent": _clamp(_number(raw.get("indent"), 0.0), 0.0, 120.0),
        "autoFit": _bool(raw.get("autoFit"), False),
    }


def normalize_text_element(raw: object) -> dict:
    if not isinstance(raw, dict):
        raise ValueError("text element must be an object")
    common = element_common(raw, default_width=35.0, default_height=18.0)
    role = raw.get("role") if raw.get("role") in VALID_TEXT_ROLES else None
    return {
        "id": common["id"], "type": "text", "role": role,
        "text": _string(raw.get("text")),
        "x": common["x"], "y": common["y"], "width": common["width"], "height": common["height"],
        "rotation": common["rotation"], "opacity": common["opacity"], "locked": common["locked"], "groupId": common["groupId"],
        "flipH": common["flipH"], "flipV": common["flipV"],
        "fill": _string(raw.get("fill"), "transparent"),
        "stroke": _string(raw.get("stroke"), "transparent"),
        "strokeWidth": _clamp(_number(raw.get("strokeWidth"), 0.0), 0.0, 20.0),
        "padding": _clamp(_number(raw.get("padding"), 1.2), 0.0, 20.0),
        **normalize_text_style(raw),
    }


def normalize_shape_element(raw: object) -> dict:
    if not isinstance(raw, dict):
        raise ValueError("shape element must be an object")
    shape = raw.get("shape") if raw.get("shape") in VALID_SHAPES else "rect"
    common = element_common(raw, default_width=25.0, default_height=18.0)
    return {
        "id": common["id"], "type": "shape", "shape": shape,
        "text": _string(raw.get("text")),
        "x": common["x"], "y": common["y"], "width": common["width"], "height": common["height"],
        "rotation": common["rotation"], "opacity": common["opacity"], "locked": common["locked"], "groupId": common["groupId"],
        "flipH": common["flipH"], "flipV": common["flipV"],
        "fill": _string(raw.get("fill"), "#e8e8e4"),
        "stroke": _string(raw.get("stroke"), "#4b4d50"),
        "strokeWidth": _clamp(_number(raw.get("strokeWidth"), 1.5), 0.0, 20.0),
        **normalize_text_style({**raw, "fontSize": raw.get("fontSize", 20.0), "verticalAlign": raw.get("verticalAlign", "middle"), "align": raw.get("align", "center")}),
    }


def normalize_table_element(raw: object) -> dict:
    if not isinstance(raw, dict):
        raise ValueError("table element must be an object")
    rows = max(1, min(50, int(_number(raw.get("rows"), 3))))
    cols = max(1, min(30, int(_number(raw.get("cols"), 3))))
    source = raw.get("cells") if isinstance(raw.get("cells"), list) else []
    cells = []
    for r in range(rows):
        row = source[r] if r < len(source) and isinstance(source[r], list) else []
        cells.append([_string(row[c]) if c < len(row) else "" for c in range(cols)])
    common = element_common(raw, default_width=55.0, default_height=max(12.0, rows * 8.0))
    style = normalize_text_style({**raw, "fontSize": raw.get("fontSize", 18.0), "align": raw.get("align", "left"), "verticalAlign": raw.get("verticalAlign", "middle")})
    return {
        "id": common["id"], "type": "table", "rows": rows, "cols": cols, "cells": cells,
        "x": common["x"], "y": common["y"], "width": common["width"], "height": common["height"],
        "rotation": common["rotation"], "opacity": common["opacity"], "locked": common["locked"], "groupId": common["groupId"],
        "flipH": common["flipH"], "flipV": common["flipV"],
        "fill": _string(raw.get("fill"), "#ffffff"), "headerFill": _string(raw.get("headerFill"), "#e8e8e4"),
        "stroke": _string(raw.get("stroke"), "#777777"), "strokeWidth": _clamp(_number(raw.get("strokeWidth"), 1.0), 0.0, 20.0),
        **style,
    }


def normalize_connector_endpoint(raw: object) -> dict:
    raw = raw if isinstance(raw, dict) else {}
    element_id = raw.get("elementId") if isinstance(raw.get("elementId"), str) and raw.get("elementId") else None
    anchor = raw.get("anchor") if raw.get("anchor") in VALID_CONNECTOR_ANCHORS else "auto"
    result = {"elementId": element_id, "anchor": anchor}
    if element_id is None:
        result["x"] = _clamp(_number(raw.get("x"), 10.0), -300.0, 300.0)
        result["y"] = _clamp(_number(raw.get("y"), 10.0), -300.0, 300.0)
    return result


def normalize_connector_element(raw: object) -> dict:
    if not isinstance(raw, dict):
        raise ValueError("connector element must be an object")
    common = element_common(raw, default_width=20.0, default_height=10.0)
    return {
        "id": common["id"], "type": "connector",
        "from": normalize_connector_endpoint(raw.get("from")), "to": normalize_connector_endpoint(raw.get("to")),
        "arrow": raw.get("arrow") if raw.get("arrow") in VALID_CONNECTOR_ARROWS else "end",
        "stroke": _string(raw.get("stroke"), "#4b4d50"), "strokeWidth": _clamp(_number(raw.get("strokeWidth"), 2.0), 0.5, 20.0),
        "dash": _bool(raw.get("dash"), False), "opacity": common["opacity"], "locked": common["locked"], "groupId": common["groupId"],
        "x": common["x"], "y": common["y"], "width": common["width"], "height": common["height"], "rotation": 0.0,
    }


THEME_PRESETS = {
    "default": {"name":"default","fontFamily":"Inter","titleFontFamily":"Inter","background":"#ffffff","text":"#202124","accent":"#2563eb"},
    "dark": {"name":"dark","fontFamily":"Inter","titleFontFamily":"Inter","background":"#202124","text":"#f5f5f4","accent":"#60a5fa"},
    "warm": {"name":"warm","fontFamily":"Georgia","titleFontFamily":"Georgia","background":"#f7f0e5","text":"#362f2a","accent":"#a44a3f"},
    "blue": {"name":"blue","fontFamily":"Inter","titleFontFamily":"Inter","background":"#f5f8ff","text":"#14213d","accent":"#2563eb"},
}


def normalize_theme(raw: object) -> dict:
    raw = raw if isinstance(raw, dict) else {}
    preset = raw.get("name") if raw.get("name") in THEME_PRESETS else "default"
    base = dict(THEME_PRESETS[preset])
    for key in ("fontFamily", "titleFontFamily", "background", "text", "accent"):
        if isinstance(raw.get(key), str) and raw.get(key): base[key] = raw[key]
    return base


def normalize_view(raw: object) -> dict:
    raw = raw if isinstance(raw, dict) else {}
    def nums(name, default):
        value = raw.get(name)
        if not isinstance(value, list): return list(default)
        return [_clamp(_number(v, 50.0), -300.0, 300.0) for v in value[:20]]
    return {
        "snapToObjects": _bool(raw.get("snapToObjects"), True),
        "snapToGrid": _bool(raw.get("snapToGrid"), False),
        "showGrid": _bool(raw.get("showGrid"), False),
        "showGuides": _bool(raw.get("showGuides"), True),
        "showElementLabels": _bool(raw.get("showElementLabels"), False),
        "gridSize": _clamp(_number(raw.get("gridSize"), 2.5), 0.25, 25.0),
        "guideX": nums("guideX", [50.0]), "guideY": nums("guideY", [50.0]),
    }


def normalize_element(raw: object) -> dict:
    if not isinstance(raw, dict):
        raise ValueError("slide element must be an object")
    kind = raw.get("type")
    if kind == "image":
        return normalize_image_element(raw)
    if kind == "text":
        return normalize_text_element(raw)
    if kind == "shape":
        return normalize_shape_element(raw)
    if kind == "table":
        return normalize_table_element(raw)
    if kind == "connector":
        return normalize_connector_element(raw)
    raise ValueError(f"unsupported element type: {kind!r}")


def expected_roles(layout: str) -> tuple[str, ...]:
    if layout == "title": return ("title",)
    if layout in {"title-body", "section"}: return ("title", "body")
    return ()


def role_template(role: str, layout: str, theme: dict, text: str = "") -> dict:
    if role not in VALID_TEXT_ROLES: raise ValueError(f"invalid text role: {role}")
    if role == "title":
        if layout == "title-body": geom={"x":8.5,"y":8.5,"width":83.0,"height":16.0,"fontSize":42.0,"align":"left"}
        else: geom={"x":10.0,"y":29.0 if layout=="section" else 31.0,"width":80.0,"height":24.0 if layout=="section" else 38.0,"fontSize":54.0,"align":"center"}
        return normalize_text_element({"type":"text","role":"title","text":text,**geom,"fontFamily":theme["titleFontFamily"],"fontWeight":700,"color":"#f5f5f4" if layout=="section" else theme["text"],"verticalAlign":"middle","fill":"transparent","stroke":"transparent"})
    geom={"x":15.0,"y":57.0,"width":70.0,"height":18.0,"fontSize":24.0,"align":"center","verticalAlign":"middle"} if layout=="section" else {"x":8.5,"y":30.0,"width":83.0,"height":56.0,"fontSize":24.0,"align":"left","verticalAlign":"top"}
    return normalize_text_element({"type":"text","role":"body","text":text,**geom,"fontFamily":theme["fontFamily"],"fontWeight":400,"color":"#d7d7d4" if layout=="section" else theme["text"],"fill":"transparent","stroke":"transparent"})


def role_element(slide_obj: dict, role: str) -> dict | None:
    return next((e for e in slide_obj.get("elements", []) if e.get("type") == "text" and e.get("role") == role), None)


def ensure_role(slide_obj: dict, role: str, theme: dict, text: str | None = None) -> dict:
    element = role_element(slide_obj, role)
    if element is None:
        element = role_template(role, slide_obj.get("layout", "title-body"), theme, text or "")
        if role == "title": slide_obj["elements"].insert(0, element)
        else: slide_obj["elements"].append(element)
    elif text is not None:
        element["text"] = text
    return element


def apply_layout_template(slide_obj: dict, layout: str, theme: dict) -> None:
    previous=slide_obj.get("layout","title-body"); slide_obj["layout"] = layout
    expected=set(expected_roles(layout))
    if layout=="section" and slide_obj.get("background") in {theme["background"],"#ffffff"}: slide_obj["background"]="#202124"
    elif previous=="section" and layout!="section" and slide_obj.get("background")=="#202124": slide_obj["background"]=theme["background"]
    slide_obj["elements"]=[e for e in slide_obj.get("elements",[]) if not (e.get("type")=="text" and e.get("role") and e.get("role") not in expected and not str(e.get("text","")).strip())]
    for role in expected_roles(layout):
        current=role_element(slide_obj, role); text=current.get("text", "") if current else ""; template=role_template(role, layout, theme, text)
        if current:
            identity={k:current.get(k) for k in ("id","groupId","locked","opacity")}; current.clear(); current.update(template); current.update(identity)
        elif role == "title": slide_obj["elements"].insert(0, template)
        else: slide_obj["elements"].append(template)


def slide(title: str = "", body: str = "", layout: str = "title-body", theme: dict | None = None) -> dict:
    theme = normalize_theme(theme)
    item={"id":str(uuid.uuid4()),"layout":layout,"background":"#202124" if layout=="section" else theme["background"],"notes":"","transition":{"type":"none","duration":0.35},"elements":[]}
    for role in expected_roles(layout): item["elements"].append(role_template(role, layout, theme, title if role=="title" else body))
    if layout == "blank" and title: item["elements"].append(role_template("title", layout, theme, title))
    if layout == "blank" and body: item["elements"].append(role_template("body", layout, theme, body))
    return item


def new_deck(title: str = "Untitled deck") -> dict:
    theme=normalize_theme(None);first=slide("", "", "title", theme)
    return {"version": VERSION, "title": title, "selectedId": first["id"], "page": normalize_page(PAGE_PRESETS["wide"]), "footer": normalize_footer(None), "theme": theme, "view": normalize_view(None), "slides": [first]}


def normalize(candidate: object) -> dict:
    if not isinstance(candidate, dict):
        raise ValueError("deck must be a JSON object")
    raw_slides = candidate.get("slides")
    if not isinstance(raw_slides, list) or not raw_slides:
        raise ValueError("deck.slides must be a non-empty array")
    theme = normalize_theme(candidate.get("theme"))
    page = normalize_page(candidate.get("page")); footer = normalize_footer(candidate.get("footer"))
    seen_slides: set[str] = set()
    slides: list[dict] = []
    for index, raw in enumerate(raw_slides, 1):
        if not isinstance(raw, dict):
            raise ValueError(f"slide {index} must be an object")
        sid = raw.get("id") if isinstance(raw.get("id"), str) and raw.get("id") else str(uuid.uuid4())
        if sid in seen_slides:
            sid = str(uuid.uuid4())
        seen_slides.add(sid)
        layout = raw.get("layout") if raw.get("layout") in VALID_LAYOUTS else "title-body"
        elements: list[dict] = []
        seen_elements: set[str] = set(); seen_roles: set[str] = set()
        raw_elements = raw.get("elements") if isinstance(raw.get("elements"), list) else []
        for raw_element in raw_elements:
            element = normalize_element(raw_element)
            if element.get("type") == "text" and element.get("role"):
                if element["role"] in seen_roles: element["role"] = None
                else: seen_roles.add(element["role"])
            if element["id"] in seen_elements: element["id"] = str(uuid.uuid4())
            seen_elements.add(element["id"]); elements.append(element)
        item={"id":sid,"layout":layout,"background":_string(raw.get("background"), "#202124" if layout=="section" else theme["background"]),"notes":_string(raw.get("notes")),"transition":normalize_transition(raw.get("transition")),"elements":elements}
        valid_ids = {e["id"] for e in item["elements"]}
        for e in item["elements"]:
            if e.get("type") == "connector":
                for endpoint in (e["from"], e["to"]):
                    if endpoint.get("elementId") not in valid_ids:
                        endpoint["elementId"] = None; endpoint.setdefault("x",10.0); endpoint.setdefault("y",10.0)
        slides.append(item)
    selected = candidate.get("selectedId")
    if selected not in seen_slides:
        selected = slides[0]["id"]
    title = candidate.get("title") if isinstance(candidate.get("title"), str) and candidate.get("title").strip() else "Untitled deck"
    return {"version": VERSION, "title": title, "selectedId": selected, "page": page, "footer": footer, "theme": theme, "view": normalize_view(candidate.get("view")), "slides": slides}


def read_deck(path: Path) -> dict:
    try:
        return normalize(json.loads(path.read_text(encoding="utf-8")))
    except FileNotFoundError:
        raise ValueError(f"deck not found: {path}") from None
    except json.JSONDecodeError as exc:
        raise ValueError(f"invalid JSON in {path}: {exc}") from None


def write_deck(path: Path, deck: dict) -> None:
    path = path.expanduser().resolve()
    path.parent.mkdir(parents=True, exist_ok=True)
    data = json.dumps(normalize(deck), ensure_ascii=False, indent=2) + "\n"
    fd, temp_name = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(data)
        os.replace(temp_name, path)
    finally:
        if os.path.exists(temp_name):
            os.unlink(temp_name)


def asset_file(deck_path: Path, image_path: str) -> Path:
    base = deck_path.expanduser().resolve().parent
    target = (base / image_path).resolve()
    try:
        target.relative_to(base)
    except ValueError:
        raise ValueError(f"asset escapes deck directory: {image_path}") from None
    return target


def import_asset(deck_path: Path, source: Path) -> str:
    source = source.expanduser().resolve()
    if not source.is_file():
        raise ValueError(f"image not found: {source}")
    ext = source.suffix.lower()
    if ext not in SUPPORTED_IMAGE_EXTS:
        raise ValueError(f"unsupported image type: {ext or '(none)'}")
    digest = hashlib.sha256(source.read_bytes()).hexdigest()[:24]
    rel = Path(ASSET_DIR) / f"{digest}{ext}"
    target = deck_path.expanduser().resolve().parent / rel
    target.parent.mkdir(parents=True, exist_ok=True)
    if not target.exists():
        shutil.copyfile(source, target)
    return rel.as_posix()


def image_dimensions(source: Path) -> tuple[float, float]:
    source = source.expanduser().resolve()
    try:
        proc = subprocess.run(["/usr/bin/sips", "-g", "pixelWidth", "-g", "pixelHeight", str(source)], check=True, capture_output=True, text=True, timeout=10)
        width = height = None
        for line in proc.stdout.splitlines():
            line = line.strip()
            if line.startswith("pixelWidth:"): width = float(line.split(":", 1)[1].strip())
            elif line.startswith("pixelHeight:"): height = float(line.split(":", 1)[1].strip())
        if width and height: return width, height
    except (OSError, ValueError, subprocess.CalledProcessError, subprocess.TimeoutExpired):
        pass
    return 16.0, 9.0


def image_elements(deck: dict):
    for item in deck["slides"]:
        for element in item.get("elements", []):
            if element.get("type") == "image":
                yield element


def copy_assets(deck: dict, source_deck: Path, target_deck: Path) -> None:
    source_base = source_deck.expanduser().resolve().parent
    target_base = target_deck.expanduser().resolve().parent
    if source_base == target_base:
        return
    for image in image_elements(deck):
        rel = image["path"]
        source = asset_file(source_deck, rel)
        if not source.is_file():
            raise ValueError(f"missing image asset: {rel}")
        target = asset_file(target_deck, rel)
        target.parent.mkdir(parents=True, exist_ok=True)
        if source.resolve() != target.resolve():
            shutil.copyfile(source, target)


def missing_assets(deck: dict, deck_path: Path) -> list[str]:
    return sorted({e["path"] for e in image_elements(deck) if not asset_file(deck_path, e["path"]).is_file()})


def resolve_slide(deck: dict, ref: str) -> tuple[int, dict]:
    try: position = int(ref)
    except ValueError: position = 0
    if position:
        if not 1 <= position <= len(deck["slides"]):
            raise ValueError(f"slide position out of range: {position}")
        return position - 1, deck["slides"][position - 1]
    for index, item in enumerate(deck["slides"]):
        if item["id"] == ref: return index, item
    raise ValueError(f"unknown slide reference: {ref}")


def resolve_element(slide_obj: dict, ref: str) -> tuple[int, dict]:
    elements = slide_obj.get("elements", [])
    if ref in {"@title", "@body"}:
        role=ref[1:]; matches=[(i,e) for i,e in enumerate(elements) if e.get("type")=="text" and e.get("role")==role]
        if len(matches)==1:return matches[0]
        raise ValueError(f"slide has no {ref} text box")
    try: position = int(ref)
    except ValueError: position = 0
    if position and len(ref) < 6 and 1 <= position <= len(elements):
        return position - 1, elements[position - 1]
    for index, item in enumerate(elements):
        if item["id"] == ref: return index, item
    if len(ref) >= 6:
        matches = [(index, item) for index, item in enumerate(elements) if item["id"].startswith(ref)]
        if len(matches) == 1: return matches[0]
        if len(matches) > 1: raise ValueError(f"ambiguous element id prefix: {ref}")
    if position and 1 <= position <= len(elements): return position - 1, elements[position - 1]
    if position: raise ValueError(f"element position out of range: {position}")
    raise ValueError(f"unknown element reference: {ref}")


def resolve_elements(slide_obj: dict, refs: list[str]) -> list[dict]:
    result=[]; seen=set()
    for ref in refs:
        _, element=resolve_element(slide_obj,ref)
        if element["id"] not in seen: result.append(element); seen.add(element["id"])
    return result


def remap_elements(elements: list[dict]) -> list[dict]:
    copies=copy.deepcopy(elements); idmap={e["id"]:str(uuid.uuid4()) for e in copies}; groupmap={}
    for e in copies:
        old=e["id"]; e["id"]=idmap[old]
        if e.get("groupId"):
            groupmap.setdefault(e["groupId"],str(uuid.uuid4())); e["groupId"]=groupmap[e["groupId"]]
        if e.get("type")=="connector":
            for endpoint in (e["from"],e["to"]):
                if endpoint.get("elementId") in idmap: endpoint["elementId"]=idmap[endpoint["elementId"]]
    return copies


def body_value(args: argparse.Namespace) -> str | None:
    body = getattr(args, "body", None)
    body_file = getattr(args, "body_file", None)
    if body is not None and body_file is not None: raise ValueError("use only one of --body and --body-file")
    if body_file is None: return body
    if body_file == "-": return sys.stdin.read()
    return Path(body_file).expanduser().read_text(encoding="utf-8")


def notes_value(args: argparse.Namespace) -> str | None:
    notes = getattr(args, "notes", None)
    notes_file = getattr(args, "notes_file", None)
    if notes is not None and notes_file is not None: raise ValueError("use only one of --notes and --notes-file")
    if notes_file is None: return notes
    if notes_file == "-": return sys.stdin.read()
    return Path(notes_file).expanduser().read_text(encoding="utf-8")


def emit(value: object, as_json: bool = False) -> None:
    if as_json: print(json.dumps(value, ensure_ascii=False, indent=2))
    elif isinstance(value, str): print(value)
    elif isinstance(value, dict) and "message" in value: print(value["message"])
    else: print(json.dumps(value, ensure_ascii=False, indent=2))


def app_path() -> Path:
    for candidate in APP_CANDIDATES:
        if candidate.exists(): return candidate
    raise ValueError("Morrow Presenter.app not found; run scripts/build-app.sh")


def launch(deck_path: Path, present: bool = False, slide_ref: str | None = None) -> None:
    app = app_path()
    args = ["open"]
    if not present: args.append("-g")
    args.extend(["-na", str(app), "--args"])
    if present: args.append("--present")
    if slide_ref: args.extend(["--slide", slide_ref])
    args.append(str(deck_path.expanduser().resolve()))
    subprocess.run(args, check=True)


def image_schema() -> dict:
    return {"type":"object","required":["id","type","path","x","y","width","height","intrinsicWidth","intrinsicHeight","crop"],"properties":{
        "id":{"type":"string"},"type":{"const":"image"},"path":{"type":"string","minLength":1},"alt":{"type":"string"},
        "x":{"type":"number"},"y":{"type":"number"},"width":{"type":"number","exclusiveMinimum":0},"height":{"type":"number","exclusiveMinimum":0},
        "intrinsicWidth":{"type":"number","exclusiveMinimum":0},"intrinsicHeight":{"type":"number","exclusiveMinimum":0},"rotation":{"type":"number"},"opacity":{"type":"number","minimum":0,"maximum":1},"locked":{"type":"boolean"},"groupId":{"type":["string","null"]},"flipH":{"type":"boolean"},"flipV":{"type":"boolean"},
        "crop":{"type":"object","required":["left","top","right","bottom"],"properties":{k:{"type":"number","minimum":0,"maximum":95} for k in ("left","top","right","bottom")}}
    }}


def schema() -> dict:
    common = {
        "id":{"type":"string"}, "x":{"type":"number"}, "y":{"type":"number"},
        "width":{"type":"number","exclusiveMinimum":0}, "height":{"type":"number","exclusiveMinimum":0},
        "rotation":{"type":"number"}, "opacity":{"type":"number","minimum":0,"maximum":1},
        "locked":{"type":"boolean"}, "groupId":{"type":["string","null"]}, "flipH":{"type":"boolean"}, "flipV":{"type":"boolean"},
    }
    text_style = {
        "fontFamily":{"type":"string"}, "fontSize":{"type":"number"}, "fontWeight":{"type":"integer"},
        "italic":{"type":"boolean"}, "underline":{"type":"boolean"}, "color":{"type":"string"},
        "align":{"enum":list(VALID_ALIGN)}, "verticalAlign":{"enum":list(VALID_VALIGN)},
        "listStyle":{"enum":list(VALID_LIST_STYLES)}, "lineSpacing":{"type":"number"}, "paragraphSpacing":{"type":"number"}, "indent":{"type":"number"}, "autoFit":{"type":"boolean"},
    }
    text_element={"type":"object","required":["id","type","text","x","y","width","height"],"properties":{**common,"type":{"const":"text"},"text":{"type":"string"},"fill":{"type":"string"},"stroke":{"type":"string"},"strokeWidth":{"type":"number"},**text_style}}
    shape_element={"type":"object","required":["id","type","shape","x","y","width","height"],"properties":{**common,"type":{"const":"shape"},"shape":{"enum":list(VALID_SHAPES)},"text":{"type":"string"},"fill":{"type":"string"},"stroke":{"type":"string"},"strokeWidth":{"type":"number"},**text_style}}
    table_element={"type":"object","required":["id","type","rows","cols","cells","x","y","width","height"],"properties":{**common,"type":{"const":"table"},"rows":{"type":"integer","minimum":1},"cols":{"type":"integer","minimum":1},"cells":{"type":"array"},"fill":{"type":"string"},"headerFill":{"type":"string"},"stroke":{"type":"string"},"strokeWidth":{"type":"number"},**text_style}}
    endpoint={"type":"object","properties":{"elementId":{"type":["string","null"]},"anchor":{"enum":list(VALID_CONNECTOR_ANCHORS)},"x":{"type":"number"},"y":{"type":"number"}}}
    connector_element={"type":"object","required":["id","type","from","to","arrow","stroke","strokeWidth"],"properties":{**common,"type":{"const":"connector"},"from":endpoint,"to":endpoint,"arrow":{"enum":list(VALID_CONNECTOR_ARROWS)},"stroke":{"type":"string"},"strokeWidth":{"type":"number"},"dash":{"type":"boolean"}}}
    slide_schema={"type":"object","required":["id","layout","background","notes","transition","elements"],"properties":{
        "id":{"type":"string"},"layout":{"enum":list(VALID_LAYOUTS)},"background":{"type":"string"},"notes":{"type":"string"},
        "transition":{"type":"object","required":["type","duration"],"properties":{"type":{"enum":list(VALID_TRANSITIONS)},"duration":{"type":"number"}}},
        "elements":{"type":"array","items":{"oneOf":[text_element,shape_element,image_schema(),table_element,connector_element]}},
    }}
    theme_schema={"type":"object","required":["name","fontFamily","titleFontFamily","background","text","accent"],"properties":{k:{"type":"string"} for k in ("name","fontFamily","titleFontFamily","background","text","accent")}}
    view_schema={"type":"object","required":["snapToObjects","snapToGrid","showGrid","showGuides","showElementLabels","gridSize","guideX","guideY"],"properties":{
        "snapToObjects":{"type":"boolean"},"snapToGrid":{"type":"boolean"},"showGrid":{"type":"boolean"},"showGuides":{"type":"boolean"},"showElementLabels":{"type":"boolean"},"gridSize":{"type":"number"},"guideX":{"type":"array","items":{"type":"number"}},"guideY":{"type":"array","items":{"type":"number"}},
    }}
    page_schema={"type":"object","required":["preset","width","height"],"properties":{"preset":{"enum":["wide","standard","custom"]},"width":{"type":"number","exclusiveMinimum":0},"height":{"type":"number","exclusiveMinimum":0}}}
    footer_schema={"type":"object","required":["text","showText","showSlideNumber","fontFamily","fontSize","color"],"properties":{"text":{"type":"string"},"showText":{"type":"boolean"},"showSlideNumber":{"type":"boolean"},"fontFamily":{"type":"string"},"fontSize":{"type":"number"},"color":{"type":"string"}}}
    return {"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Morrow Presenter deck","type":"object","required":["version","title","page","footer","theme","view","slides"],"properties":{
        "version":{"const":VERSION},"title":{"type":"string"},"selectedId":{"type":"string"},"page":page_schema,"footer":footer_schema,"theme":theme_schema,"view":view_schema,"slides":{"type":"array","minItems":1,"items":slide_schema},
    }}


def capabilities() -> dict:
    return {
        "name":"Morrow Presenter","cli":"morrow-presenter","deck_format":"morrowdeck-json-v1","shell_first":True,"requires_mcp":False,
        "slide_refs":"1-based position or stable slide id","element_refs":"1-based position, stable element id, unique id prefix (6+ chars), @title, or @body","layouts":list(VALID_LAYOUTS),
        "element_types":list(VALID_ELEMENT_TYPES),"shapes":list(VALID_SHAPES),"transitions":list(VALID_TRANSITIONS),"themes":list(VALID_THEME_PRESETS),
        "features":["multi-object canvas","unified title/body text roles","text boxes","bullets and numbering","paragraph spacing and indent","text autofit","precise geometry","object flipping","wide and standard slide sizes","footer and slide numbers","basic shapes","multiple images","tables","auto connectors","groups","snap to objects","snap to grid","guides","element labels","themes","non-destructive crop","rotation","opacity","z-order","align/distribute","slide backgrounds","speaker notes","fade transitions"],
        "image_storage":f"relative files under {ASSET_DIR}/",
        "operations":["new","validate","info","slides","get","title","add","set","duplicate","delete","move","slide-style","page-size","footer-set","theme","theme-set","view-settings","elements","element-get","element-add-text","element-add-shape","element-add-image","element-add-table","element-add-connector","element-update","table-set","table-resize","table-row-add","table-row-delete","table-col-add","table-col-delete","element-delete","element-duplicate","element-group","element-ungroup","element-order","element-align","open","present","export","export-pdf","export-pptx","import-pptx","schema","capabilities"],
        "agent_docs":str(Path(__file__).resolve().parents[1]/"docs"/"AGENT.md"),
    }


def add_json(sp): sp.add_argument("--json", action="store_true", help="emit machine-readable JSON")
def add_body_options(sp):
    sp.add_argument("--body"); sp.add_argument("--body-file", help="read body from UTF-8 file, or - for stdin")
def add_notes_options(sp):
    sp.add_argument("--notes"); sp.add_argument("--notes-file", help="read notes from UTF-8 file, or - for stdin")
def add_geometry(sp, *, defaults=False):
    sp.add_argument("--x", type=float, default=10.0 if defaults else None)
    sp.add_argument("--y", type=float, default=10.0 if defaults else None)
    sp.add_argument("--width", type=float, default=35.0 if defaults else None)
    sp.add_argument("--height", type=float, default=18.0 if defaults else None)
def add_text_style(sp, *, defaults=False):
    sp.add_argument("--font-family", default="Inter" if defaults else None)
    sp.add_argument("--font-size", type=float, default=28.0 if defaults else None)
    sp.add_argument("--font-weight", type=int, default=400 if defaults else None)
    sp.add_argument("--italic", dest="italic", action="store_const", const=True, default=False if defaults else None)
    sp.add_argument("--no-italic", dest="italic", action="store_const", const=False)
    sp.add_argument("--underline", dest="underline", action="store_const", const=True, default=False if defaults else None)
    sp.add_argument("--no-underline", dest="underline", action="store_const", const=False)
    sp.add_argument("--color", default="#202124" if defaults else None)
    sp.add_argument("--align", choices=VALID_ALIGN, default="left" if defaults else None)
    sp.add_argument("--vertical-align", choices=VALID_VALIGN, default="top" if defaults else None)
    sp.add_argument("--list-style", choices=VALID_LIST_STYLES, default="none" if defaults else None)
    sp.add_argument("--line-spacing", type=float, default=1.2 if defaults else None)
    sp.add_argument("--paragraph-spacing", type=float, default=0.0 if defaults else None)
    sp.add_argument("--indent", type=float, default=0.0 if defaults else None)
    sp.add_argument("--auto-fit", dest="auto_fit", action="store_const", const=True, default=False if defaults else None)
    sp.add_argument("--no-auto-fit", dest="auto_fit", action="store_const", const=False)


def parser() -> argparse.ArgumentParser:
    p=argparse.ArgumentParser(prog="morrow-presenter", description="Shell-first slide deck editor and presenter")
    p.add_argument("--version", action="version", version=f"Morrow Presenter CLI format-v{VERSION}")
    subs=p.add_subparsers(dest="command", required=True)
    sp=subs.add_parser("capabilities"); add_json(sp)
    sp=subs.add_parser("schema"); add_json(sp)
    sp=subs.add_parser("new"); sp.add_argument("path",type=Path); sp.add_argument("--title",default="Untitled deck"); sp.add_argument("--force",action="store_true"); add_json(sp)
    sp=subs.add_parser("import-pptx"); sp.add_argument("input",type=Path); sp.add_argument("output",type=Path); sp.add_argument("--force",action="store_true"); add_json(sp)
    for name in ("validate","info","slides"):
        sp=subs.add_parser(name); sp.add_argument("path",type=Path); add_json(sp)
    sp=subs.add_parser("get"); sp.add_argument("path",type=Path); sp.add_argument("slide"); add_json(sp)
    sp=subs.add_parser("title"); sp.add_argument("path",type=Path); sp.add_argument("title"); add_json(sp)
    sp=subs.add_parser("add"); sp.add_argument("path",type=Path); sp.add_argument("--after"); sp.add_argument("--layout",choices=VALID_LAYOUTS,default="title-body"); sp.add_argument("--title",default=""); add_body_options(sp); add_json(sp)
    sp=subs.add_parser("set"); sp.add_argument("path",type=Path); sp.add_argument("slide"); sp.add_argument("--layout",choices=VALID_LAYOUTS); sp.add_argument("--title"); add_body_options(sp); add_json(sp)
    for name in ("duplicate","delete"):
        sp=subs.add_parser(name); sp.add_argument("path",type=Path); sp.add_argument("slide"); add_json(sp)
    sp=subs.add_parser("move"); sp.add_argument("path",type=Path); sp.add_argument("slide"); sp.add_argument("--to",type=int,required=True); add_json(sp)
    sp=subs.add_parser("slide-style"); sp.add_argument("path",type=Path); sp.add_argument("slide"); sp.add_argument("--background"); add_notes_options(sp); sp.add_argument("--transition",choices=VALID_TRANSITIONS); sp.add_argument("--transition-duration",type=float); add_json(sp)
    sp=subs.add_parser("page-size"); sp.add_argument("path",type=Path); sp.add_argument("preset",choices=tuple(PAGE_PRESETS)); add_json(sp)
    sp=subs.add_parser("footer-set"); sp.add_argument("path",type=Path); sp.add_argument("--text"); sp.add_argument("--show-text",dest="show_text",action="store_const",const=True); sp.add_argument("--hide-text",dest="show_text",action="store_const",const=False); sp.add_argument("--show-slide-number",dest="show_slide_number",action="store_const",const=True); sp.add_argument("--hide-slide-number",dest="show_slide_number",action="store_const",const=False); sp.add_argument("--font-family"); sp.add_argument("--font-size",type=float); sp.add_argument("--color"); add_json(sp)
    sp=subs.add_parser("theme"); sp.add_argument("path",type=Path); add_json(sp)
    sp=subs.add_parser("theme-set"); sp.add_argument("path",type=Path); sp.add_argument("preset",choices=VALID_THEME_PRESETS); sp.add_argument("--apply-all",action="store_true"); add_json(sp)
    sp=subs.add_parser("view-settings"); sp.add_argument("path",type=Path); sp.add_argument("--snap-to-objects",dest="snap_to_objects",action="store_const",const=True); sp.add_argument("--no-snap-to-objects",dest="snap_to_objects",action="store_const",const=False); sp.add_argument("--snap-to-grid",dest="snap_to_grid",action="store_const",const=True); sp.add_argument("--no-snap-to-grid",dest="snap_to_grid",action="store_const",const=False); sp.add_argument("--show-grid",dest="show_grid",action="store_const",const=True); sp.add_argument("--hide-grid",dest="show_grid",action="store_const",const=False); sp.add_argument("--show-guides",dest="show_guides",action="store_const",const=True); sp.add_argument("--hide-guides",dest="show_guides",action="store_const",const=False); sp.add_argument("--show-element-labels",dest="show_element_labels",action="store_const",const=True); sp.add_argument("--hide-element-labels",dest="show_element_labels",action="store_const",const=False); sp.add_argument("--grid-size",type=float); sp.add_argument("--guide-x",type=float,action="append"); sp.add_argument("--guide-y",type=float,action="append"); sp.add_argument("--clear-guides",action="store_true"); add_json(sp)
